# Copy this file to paths.env and edit it:  cp paths.example.env paths.env
# paths.env is git-ignored. Every launcher sources it through scripts/env.sh.

# [required] Directory that holds the raw videos/audio, laid out as
#   $MEDIA_ROOT/unav_100/videos/<id>.mp4
#   $MEDIA_ROOT/unav_100/audio/<id>.wav
#   $MEDIA_ROOT/charades_sta/Charades_v1/<id>.mp4
# Dataset JSONs under data/ store paths relative to this directory.
export MEDIA_ROOT=/path/to/media

# [optional] Where models and results live (defaults: <repo>/checkpoints, <repo>/outputs)
# export CKPT_DIR=/path/to/checkpoints
# export OUTPUT_DIR=/path/to/outputs

# [optional] Weights & Biases. Without an API key, runs are logged offline.
# export WANDB_ENTITY=<your-entity>
# export WANDB_API_KEY=<your-api-key>
